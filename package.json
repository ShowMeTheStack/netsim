{
  "name": "netsim",
  "version": "0.1.0",
  "description": "A browser-based, client-side IPv4 network simulator for learning. Build topologies on a canvas, watch real protocols run packet by packet, and inspect every frame.",
  "homepage": "https://netsim.jyotiprakash.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowMeTheStack/netsim.git"
  },
  "author": "Jyotiprakash Mishra <mail@jyotiprakash.org>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "binaryen": "^132.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wabt": "^1.0.36"
  }
}
